    "parameters": [],
    "rules_zh": "按所有动物园中的熊类图标获得X标记，最多3枚。",
    "edge_cases_zh": []
  },
  "inventive_primate": {
    "name_zh": "创造力：灵长类",
    "name_en": "Inventive: Primates",
