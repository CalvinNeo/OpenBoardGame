    "edge_cases_zh": []
  },
  "full_throated": {
    "name_zh": "呼唤",
    "name_en": "Full-throated",
    "timing": "immediate",
    "cascade": "hire_worker",
    "parameters": [],
    "rules_zh": "从个人板最低的协会事务员储存位雇佣1名事务员。",
    "edge_cases_zh": [
      "若已全部雇佣则无效果。"
    ]
  },
  "jumping": {
    "name_zh": "跳跃",
    "name_en": "Jumping",
    "timing": "immediate",
    "cascade": "advance_break",
    "parameters": [
      "break_steps",
      "money"
    ],
    "rules_zh": "将休息标记推进N格并获得N金币。",
    "edge_cases_zh": [
      "若到达最后一格，先得1枚X标记，回合结束后再结算休息。"
    ]
  },
  "multiplier_association": {
    "name_zh": "双重：协会",
    "name_en": "Multiplier: Association",
    "timing": "immediate",
    "cascade": "future_multi_action",
    "parameters": [],
    "rules_zh": "在协会行动牌上放1枚双倍标记；下次执行时，每枚标记都让该行动以相同强度多执行一次。",
    "edge_cases_zh": [
      "多枚双倍标记可以叠加。",
      "X标记只增强其中一次子行动；全部子行动完成后才处理“行动后”效果和休息。",
      "使用后或下次休息时归还。"
    ]
  },
  "multiplier_building": {
